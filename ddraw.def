LIBRARY ddraw.dll
EXPORTS
    DirectDrawCreate = FakeDirectDrawCreate @1
    DirectDrawCreateClipper = FakeDirectDrawCreateClipper @2
    DirectDrawCreateEx = FakeDirectDrawCreateEx @3
    DirectDrawEnumerateA = FakeDirectDrawEnumerateA @4
    DirectDrawEnumerateExA = FakeDirectDrawEnumerateExA @5
    DirectDrawEnumerateExW = FakeDirectDrawEnumerateExW @6
    DirectDrawEnumerateW = FakeDirectDrawEnumerateW @7
    DllCanUnloadNow = FakeDllCanUnloadNow PRIVATE
    DllGetClassObject = FakeDllGetClassObject PRIVATE
